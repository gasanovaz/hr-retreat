# Закрываем доступ извне к секретам SMTP/оплат/админки, библиотекам, резервному хранилищу заявок и логам
<FilesMatch "(^\.|^_.*\.php$|^\.(smtp|payment|admin|waitlist)_secret\.php$|\.(jsonl|log|txt|bak)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
